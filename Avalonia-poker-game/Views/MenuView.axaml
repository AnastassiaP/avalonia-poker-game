<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avalonia_poker_game.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
             x:Class="Avalonia_poker_game.Views.MenuView"
             x:DataType="vm:MenuViewModel">

    <Grid RowDefinitions="*, Auto, Auto, *" Background="Black">
        <TextBlock Grid.Row="1"
                   Text="POKER GAME"
                   FontFamily="{StaticResource MonotonFont}"
                   Foreground="#FF2FD1"
                   FontSize="56"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,48">
            <TextBlock.Effect>
                <DropShadowEffect Color="#FF2FD1" BlurRadius="24" OffsetX="0" OffsetY="0" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>

        <StackPanel Grid.Row="2"
                    Spacing="16"
                    HorizontalAlignment="Center">
            <Button Content="Play"
                    Command="{Binding PlayCommand}"
                    Classes="menuButton"/>
            <Button Content="Settings"
                    Command="{Binding SettingsCommand}"
                    Classes="menuButton"/>
        </StackPanel>
    </Grid>

</UserControl>
