<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Avalonia_poker_game.App"
             xmlns:local="using:Avalonia_poker_game"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <FontFamily x:Key="MonotonFont">avares://Avalonia-poker-game/Assets/Fonts#Monoton</FontFamily>
        <FontFamily x:Key="TiltNeonFont">avares://Avalonia-poker-game/Assets/Fonts#Tilt Neon</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia-poker-game/Assets/Styles/MenuButtonStyles.axaml"/>
        <StyleInclude Source="avares://Avalonia-poker-game/Assets/Styles/GameButtonStyles.axaml"/>
    </Application.Styles>
</Application>